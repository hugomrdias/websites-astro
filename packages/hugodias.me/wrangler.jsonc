{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "hugodias-me-dev",
    "compatibility_date": "2025-06-16",
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
    },
    "preview_urls": true,
    "workers_dev": true,
    "env": {
        "production": {
            "name": "hugodias-me",
            "compatibility_date": "2025-06-16",
            "assets": {
                "directory": "./dist",
                "not_found_handling": "single-page-application"
            },
            "routes": [
                {
                    "pattern": "hugodias.me",
                    "custom_domain": true
                }
            ],
            "preview_urls": false,
            "workers_dev": false
        }
    }
}