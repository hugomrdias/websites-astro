{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hugodias-me-dev",
  "compatibility_date": "2025-06-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "preview_urls": true,
  "workers_dev": true,
  // Pull request Previews (`wrangler preview`) live under this Worker.
  "previews": {},
  "env": {
    "production": {
      "name": "hugodias-me",
      "compatibility_date": "2025-06-16",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      },
      "routes": [
        {
          "pattern": "hugodias.me",
          "custom_domain": true
        }
      ],
      "preview_urls": false,
      "workers_dev": false
    }
  }
}
