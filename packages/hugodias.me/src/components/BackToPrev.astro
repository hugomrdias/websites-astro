---
type Props = {
  href: string
}

const { href } = Astro.props
---

{/* biome-ignore lint/a11y/useAnchorContent: the slot supplies the link text */}
<a href={href} class="button Button-variant Button--small BackTo">
  <svg
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
  >
    <line x1="5" y1="12" x2="19" y2="12"></line>
    <polyline points="12 5 5 12 12 19"></polyline>
  </svg>
  <slot />
</a>
