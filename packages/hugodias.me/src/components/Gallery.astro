---
import type { ImageMetadata } from 'astro'
import { Image, getImage } from 'astro:assets'

type Props = {
  images: ImageMetadata[]
}
const { images } = Astro.props

const items = await Promise.all(
  images.map(async (image) => {
    const original = await getImage({
      src: image,
      width: image.width,
      format: 'webp',
    })
    return { image, original }
  })
)
---

{items.length > 0 && (
  <div class="Gallery">
    {items.map(({ image, original }) => {
      return (
        <a
          href={original.src}
          data-pswp-width={original.options.width}
          data-pswp-height={original.options.height}
        >
          <Image src={image} alt="" height={120} />
        </a>
      )
    })}
  </div>
)}
