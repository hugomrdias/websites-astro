{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // Notion content changes without a code change, so never replay a build.
      "cache": false,
      "env": [
        "GOOGLE_MAPS",
        "NOTION_DATA_SOURCE_ID",
        "NOTION_TOKEN",
        "TURNSTILE_SITE_KEY"
      ]
    },
    "lint": {
      "outputs": ["worker-configuration.d.ts"],
      // astro check syncs the Notion content collection.
      "passThroughEnv": [
        "GOOGLE_MAPS",
        "NOTION_DATA_SOURCE_ID",
        "NOTION_TOKEN",
        "TURNSTILE_SITE_KEY"
      ]
    }
  }
}
