---
import { NotroContent } from 'notro-loader'
import ArticleContents from './ArticleContents.astro'
import ArticleImage from './ArticleImage.astro'
import ArticleLink from './ArticleLink.astro'
import { articleCategoryLabel } from '../../lib/article-categories'
import { normalizeArticleMarkdown } from '../../lib/article-markdown'
import { buildArticleJsonLd } from '../../lib/article-jsonld'
import { ogImageUrl } from '../../lib/og-image'
import { ui } from '../../i18n/ui'
import Layout from '../../layouts/Layout.astro'
import { translatePath } from '../../i18n/utils'
import Header from '../Header.astro'
import Footer from '../Footer.astro'
import ArticleCard from './ArticleCard.astro'
import {
  articleDate,
  articleUrl,
  articlesUrl,
  getArticles,
  journalCopy,
  readingTime,
  type Article,
} from '../../lib/articles'
import '../../styles/journal.css'
interface Props {
  article: Article
}
const { article } = Astro.props
const { title, description, lang, category, author, publishedAt, sample } =
  article.data
const copy = journalCopy[lang]
const articles = await getArticles()
const translation = articles.find(
  (item) =>
    item.data.translationKey === article.data.translationKey &&
    item.data.lang !== lang
)
const alternatePaths = {
  [lang]: articleUrl(article),
  [lang === 'pt' ? 'en' : 'pt']: translation
    ? articleUrl(translation)
    : articlesUrl(lang === 'pt' ? 'en' : 'pt'),
}
const related = articles
  .filter((item) => item.data.lang === lang && item.id !== article.id)
  .sort(
    (a, b) =>
      Number(b.data.category === category) -
      Number(a.data.category === category)
  )
  .slice(0, 2)
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href
const breadcrumbs = [
  {
    name: ui[lang]['nav.home'],
    url: new URL(translatePath(lang), Astro.site).href,
  },
  {
    name: ui[lang]['nav.articles'],
    url: new URL(articlesUrl(lang), Astro.site).href,
  },
  { name: title, url: canonicalUrl },
]
const jsonLd = buildArticleJsonLd(
  article,
  canonicalUrl,
  await ogImageUrl(Astro.site),
  translation
    ? {
        article: translation,
        url: new URL(articleUrl(translation), Astro.site).href,
      }
    : undefined
)
---

<Layout
  lang={lang}
  title={`${title} — IVS Legal`}
  description={description}
  type="article"
  noindex={sample}
  breadcrumbs={breadcrumbs}
  alternatePaths={{
    [lang]: articleUrl(article),
    ...(translation && !translation.data.sample
      ? { [translation.data.lang]: articleUrl(translation) }
      : {}),
  }}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
    ></script>
    <meta
      property="article:modified_time"
      content={article.data.last_edited_time}
    />
    <meta
      property="article:published_time"
      content={publishedAt.toISOString()}
    />
    <meta property="article:author" content={author} />
  </Fragment>
  <Header alternatePaths={alternatePaths} />
  <main class="journal">
    <article>
      <header class="journal-hero">
        <div class="container mx-auto px-4">
          <div class="journal-article-header">
            <a class="journal-back" href={articlesUrl(lang)} data-agent-skip>
              <span aria-hidden="true">←</span>
              {copy.back}
            </a>
            <p class="journal-eyebrow" data-agent-skip>
              {articleCategoryLabel(category, lang)}
            </p>
            <h1>{title}</h1>
            <p class="journal-lead">{description}</p>
            <div class="journal-byline" data-agent-skip>
              <span>{author}</span>
              <span>
                {copy.published}:
                <time datetime={publishedAt.toISOString()}>
                  {articleDate(article)}
                </time>
              </span>
              <span>
                {copy.updated}:
                <time datetime={article.data.last_edited_time}>
                  {articleDate(
                    article,
                    new Date(article.data.last_edited_time)
                  )}
                </time>
              </span>
              <span>
                {readingTime(article)} {copy.minute}
              </span>
            </div>
          </div>
        </div>
      </header>
      <div class="journal-wrap journal-reading-wrap container mx-auto px-4">
        {sample && (
          <aside class="journal-sample">
            <span>{copy.sample}</span>
            <p>{copy.sampleNote}</p>
          </aside>
        )}
        <div class="journal-reading-layout">
          <aside class="journal-toc">
            <ArticleContents label={copy.contents} />
          </aside>
          <div class="journal-prose">
            <NotroContent
              markdown={normalizeArticleMarkdown(article.data.markdown)}
              components={{
                img: ArticleImage,
                a: ArticleLink,
                PageRef: ArticleLink,
                MentionPage: ArticleLink,
              }}
            />
          </div>
        </div>
      </div>
    </article>
    <div class="journal-wrap container mx-auto px-4">
      <section class="journal-contact">
        <div>
          <h2>{copy.contactTitle}</h2>
          <p>{copy.contactText}</p>
        </div>
        <a class="journal-button" href={translatePath(lang, 'contact')}>
          {copy.contact}
          <span aria-hidden="true">↗</span>
        </a>
      </section>
      {related.length > 0 && (
        <section class="journal-related" aria-labelledby="related-title">
          <h2 id="related-title">{copy.related}</h2>
          <div class="journal-grid journal-grid-two">
            {related.map((item) => (
              <ArticleCard article={item} />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
  <Footer />
</Layout>
