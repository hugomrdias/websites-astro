---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { CONTACTS, OFFICE_MAPS_URL } from '@consts'
import { getLangFromUrl, useTranslations, translatePath } from '../i18n/utils'
import logo from '../assets/mono-queen.png'
import { articlesUrl } from '../lib/articles'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<footer class="bg-navy-900 text-white">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Company Info -->
      <div class="lg:col-span-2">
        <div class="flex items-center space-x-3 mb-4">
          <Image
            src={logo}
            alt="IVS Legal"
            class="h-10 w-auto brightness-0 invert"
          />
          <div>
            <h2 class="text-xl font-serif font-semibold">
              {t('footer.company')}
            </h2>
            <p class="text-gold-400 text-sm">{t('footer.tagline')}</p>
          </div>
        </div>
        <p class="text-gray-300 mb-4 max-w-md">{t('footer.description')}</p>
        <div class="flex space-x-4">
          <a
            href="https://x.com/ivslegal"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-gold-400 transition-colors"
            title="IVS Legal — X"
            aria-label="IVS Legal — X"
          >
            <Icon name="lucide:twitter" class="w-5 min-w-5 h-5" />
          </a>
          <a
            href={translatePath(lang, 'vcard')}
            class="text-gray-400 hover:text-gold-400 transition-colors"
            title="Vcard"
          >
            <Icon name="lucide:qr-code" class="w-5 min-w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-gold-400">
          {t('footer.quickLinks')}
        </h3>
        <ul class="space-y-2">
          <li>
            <a
              href={translatePath(lang, 'about')}
              class="text-gray-300 hover:text-gold-400 transition-colors"
            >
              {t('nav.about')}
            </a>
          </li>
          <li>
            <a
              href={translatePath(lang, '#areas-pratica')}
              class="text-gray-300 hover:text-gold-400 transition-colors"
            >
              {t('nav.practice-areas')}
            </a>
          </li>
          <li>
            <a
              href={articlesUrl(lang)}
              class="text-gray-300 hover:text-gold-400 transition-colors"
            >
              {t('nav.articles')}
            </a>
          </li>
          <li>
            <a
              href={translatePath(lang, 'contact')}
              class="text-gray-300 hover:text-gold-400 transition-colors"
            >
              {t('nav.contact')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-gold-400">
          {t('footer.contact')}
        </h3>
        <div class="space-y-3 text-gray-300">
          <div class="flex items-center gap-2">
            <Icon name="lucide:map-pin" class="w-5 min-w-5 h-5 text-gold-400" />
            <p>
              <a
                href={OFFICE_MAPS_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-300 hover:text-gold-400 transition-colors"
              >
                {CONTACTS.ADDRESS}
              </a>
            </p>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="lucide:phone" class="w-5 min-w-5 h-5 text-gold-400" />
            <p>
              <a
                class="text-gray-300 hover:text-gold-400 transition-colors"
                href={`tel:${CONTACTS.PHONE.replace(/\s/g, '')}`}
              >
                {CONTACTS.PHONE}
              </a>
            </p>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="lucide:mail" class="w-5 min-w-5 h-5 text-gold-400" />
            <p>
              <a
                class="text-gray-300 hover:text-gold-400 transition-colors"
                href={`mailto:${CONTACTS.EMAIL}`}
              >
                {CONTACTS.EMAIL}
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-700 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center">
      <p class="text-gray-400 text-sm">
        © <current-year>{new Date().getFullYear()}</current-year>{' '}
        {t('footer.copyright')}
      </p>
      <div class="flex space-x-6 mt-4 md:mt-0">
        <a
          href={translatePath(lang, 'privacy')}
          class="text-gray-400 hover:text-gold-400 text-sm transition-colors"
        >
          {t('footer.privacy')}
        </a>
        <a
          href={translatePath(lang, 'terms')}
          class="text-gray-400 hover:text-gold-400 text-sm transition-colors"
        >
          {t('footer.terms')}
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  class CurrentYear extends HTMLElement {
    connectedCallback() {
      this.textContent = String(new Date().getFullYear())
    }
  }

  if (!customElements.get('current-year')) {
    customElements.define('current-year', CurrentYear)
  }
</script>
