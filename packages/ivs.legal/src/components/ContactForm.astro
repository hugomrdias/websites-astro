---
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import { CONTACTS, OFFICE_MAPS_URL } from '@consts'
import ContactFields from './ContactFields.astro'
import { Icon } from 'astro-icon/components'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<section class="py-20 bg-navy-900 text-white">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div>
          <h2 class="text-4xl font-serif font-bold mb-4">
            {t('contact.title')}{' '}
            <span class="text-gold-400">{t('contact.title.highlight')}</span>
          </h2>
          <p class="text-xl text-gray-300 leading-relaxed">
            {t('contact.subtitle')}
          </p>
        </div>

        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-gold-500 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
              <Icon name="lucide:map-pin" class="w-5 min-w-5 h-5 text-white" />
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gold-400">
                {t('contact.location')}
              </h3>
              <p class="text-gray-300">
                <a
                  href={OFFICE_MAPS_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline underline-offset-4"
                >
                  {CONTACTS.ADDRESS}
                </a>
              </p>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-gold-500 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
              <Icon name="lucide:phone" class="w-5 min-w-5 h-5 text-white" />
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gold-400">
                {t('contact.phone')}
              </h3>
              <a
                class="text-gray-300 underline underline-offset-4"
                href={`tel:${CONTACTS.PHONE.replace(/\s/g, '')}`}
              >
                {CONTACTS.PHONE}
              </a>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-gold-500 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
              <Icon name="lucide:mail" class="w-5 min-w-5 h-5 text-white" />
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gold-400">
                {t('contact.email')}
              </h3>
              <a
                class="text-gray-300 underline underline-offset-4"
                href={`mailto:${CONTACTS.EMAIL}`}
              >
                {CONTACTS.EMAIL}
              </a>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-gold-500 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
              <Icon name="lucide:clock" class="w-5 min-w-5 h-5 text-white" />
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gold-400">
                {t('contact.hours')}
              </h3>
              <p class="text-gray-300">{t('contact.hours.data')}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="bg-white rounded-xl p-8 text-navy-900">
        <h3 class="text-2xl font-semibold mb-6">{t('contact.form.title')}</h3>

        <ContactFields />
      </div>
    </div>
  </div>
</section>
