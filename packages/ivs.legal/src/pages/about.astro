---
import { articleCategoryLabel } from '../lib/article-categories'
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { Image } from 'astro:assets'
import logo from '../assets/mono-queen.png'
---

<Layout
  pageType="AboutPage"
  title="Sobre Nós - IVS Legal"
  description="Conheça Isabel Veiga e Luísa Pinho de Sousa, as advogadas da IVS Legal em Matosinhos, e os valores que orientam o acompanhamento de cada cliente."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-navy-900 to-navy-800 text-white py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-5xl font-serif font-bold mb-6">
            Sobre a <span class="text-gold-400">IVS Legal</span>
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed">
            Garantimos ética, transparência e proximidade na relação com os
            clientes.
          </p>
        </div>
      </div>
    </section>

    <!-- Mission & Values -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-4xl font-serif font-bold text-navy-900 mb-6">
              A Nossa <span class="text-gold-800">Missão</span>
            </h2>
            <p class="text-lg text-gray-700 mb-6 leading-relaxed">
              Bem-vindos ao nosso escritório de advocacia! Somos duas advogadas
              apaixonadas pelo Direito e pelo compromisso com a Justiça, que
              decidiram unir as suas experiências e conhecimentos para oferecer
              um serviço personalizado e de excelência.
            </p>
            <p class="text-lg text-gray-700 mb-6 leading-relaxed">
              O nosso escritório nasce do desejo de proporcionar um atendimento
              próximo, humano e eficiente, sempre pautado na ética,
              transparência e na busca das melhores soluções jurídicas para os
              nossos clientes, primando sempre pela confidencialidade, tão
              importante nos dias que correm.
            </p>
            <p class="text-lg text-gray-700 leading-relaxed">
              Acreditamos no poder do diálogo e da proximidade, proporcionando
              uma experiência jurídica baseada na escuta ativa e em estratégias
              sob medida para cada necessidade.
            </p>
          </div>
          <div class="relative">
            <div class="bg-gold-50 rounded-2xl p-8">
              <Image
                src={logo}
                alt="IVS Legal"
                class="w-full max-w-sm mx-auto"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-serif font-bold text-navy-900 mb-4">
            Os Nossos <span class="text-gold-800">Valores</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-20 h-20 bg-gold-500 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg
                aria-hidden="true"
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-navy-900 mb-4">
              Integridade
            </h3>
            <p class="text-gray-600">
              Atuamos sempre com transparência, honestidade e ética profissional
              em todas as nossas relações.
            </p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-gold-500 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg
                aria-hidden="true"
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-navy-900 mb-4">
              Compromisso
            </h3>
            <p class="text-gray-600">
              Priorizamos a satisfação, proteção dos direitos e interesses dos
              nossos clientes.
            </p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-gold-500 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg
                aria-hidden="true"
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-navy-900 mb-4">Dedicação</h3>
            <p class="text-gray-600">
              Cada cliente é único e merece toda a nossa atenção e empenho na
              resolução dos seus desafios jurídicos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Team -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-serif font-bold text-navy-900 mb-4">
            A Nossa <span class="text-gold-800">Equipa</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
          <!-- Team Member 1 -->
          <div id="isabel-veiga" class="text-center group scroll-mt-24">
            <div class="relative mb-6">
              <div class="w-48 h-48 bg-gradient-to-br from-gold-100 to-gold-200 rounded-full mx-auto flex items-center justify-center">
                <div class="w-32 h-32 bg-gold-500 rounded-full flex items-center justify-center">
                  <span class="text-3xl font-bold text-navy-900">IV</span>
                </div>
              </div>
            </div>
            <h3 class="text-xl font-semibold text-navy-900 mb-2">
              Isabel Veiga
            </h3>
            <p class="text-gray-600 text-sm mb-4">
              Mestrado em Direito do Trabalho pela Universidade Católica
              Portuguesa - Porto.
            </p>
            <div class="flex justify-center space-x-3">
              <span class="px-3 py-1 bg-gold-100 text-gold-800 text-xs rounded-full">
                {articleCategoryLabel('corporate-law', 'pt')}
              </span>
              <span class="px-3 py-1 bg-gold-100 text-gold-800 text-xs rounded-full">
                {articleCategoryLabel('employment-law', 'pt')}
              </span>
              <span class="px-3 py-1 bg-gold-100 text-gold-800 text-xs rounded-full">
                {articleCategoryLabel('real-estate-law', 'pt')}
              </span>
              <span class="px-3 py-1 bg-gold-100 text-gold-800 text-xs rounded-full">
                {articleCategoryLabel('immigration-law', 'pt')}
              </span>
            </div>
          </div>

          <!-- Team Member 2 -->
          <div id="luisa-pinho-de-sousa" class="text-center group scroll-mt-24">
            <div class="relative mb-6">
              <div class="w-48 h-48 bg-gradient-to-br from-gold-100 to-gold-200 rounded-full mx-auto flex items-center justify-center">
                <div class="w-32 h-32 bg-gold-500 rounded-full flex items-center justify-center">
                  <span class="text-3xl font-bold text-navy-900">LP</span>
                </div>
              </div>
            </div>
            <h3 class="text-xl font-semibold text-navy-900 mb-2">
              Luísa Pinho de Sousa
            </h3>
            <p class="text-gray-600 text-sm mb-4">
              Mestrado em Direito do Trabalho pela Universidade Católica
              Portuguesa - Porto.
            </p>
            <div class="flex justify-center space-x-3">
              <span class="px-3 py-1 bg-gold-100 text-gold-800 text-xs rounded-full">
                {articleCategoryLabel('civil-law', 'pt')}
              </span>
              <span class="px-3 py-1 bg-gold-100 text-gold-800 text-xs rounded-full">
                {articleCategoryLabel('employment-law', 'pt')}
              </span>
              <span class="px-3 py-1 bg-gold-100 text-gold-800 text-xs rounded-full">
                {articleCategoryLabel('criminal-law', 'pt')}
              </span>
              <span class="px-3 py-1 bg-gold-100 text-gold-800 text-xs rounded-full">
                {articleCategoryLabel('immigration-law', 'pt')}
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
