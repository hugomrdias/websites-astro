---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
---

<Layout
  title="404 — Página não encontrada / Page not found | IVS Legal"
  noindex
>
  <Header />
  <main class="bg-navy-900 text-white px-6 py-32 text-center">
    <p class="text-gold-400 text-xl mb-4">404</p>
    <h1 class="font-serif text-4xl mb-6">Página não encontrada</h1>
    <p class="mb-4">Esta página não existe ou foi movida.</p>
    <p lang="en" class="mb-8">
      This page does not exist or has moved.
    </p>
    <div class="flex justify-center gap-8">
      <a class="text-gold-400 underline" href="/">
        Página inicial
      </a>
      <a class="text-gold-400 underline" href="/en/" lang="en">
        English homepage
      </a>
    </div>
  </main>
  <Footer />
</Layout>
