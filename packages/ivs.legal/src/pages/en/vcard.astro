---
import Layout from '@layouts/Layout.astro'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import QR from '@components/qr'
import { CONTACTS, VCARD_PATH } from '@consts'
---

<Layout
  lang="en"
  title="Virtual Card - IVS Legal"
  description="Save IVS Legal’s contact details to your phone using our digital business card."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-navy-900 to-navy-800 text-white py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-5xl font-serif font-bold mb-6">
            Virtual <span class="text-gold-400">Card</span>
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed">
            Add our vCard to your contacts.
          </p>
        </div>
      </div>
    </section>

    <!-- Content -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto prose prose-lg">
          <QR />
          <ul class="mt-10 space-y-1 text-center list-none text-gray-700">
            <li>
              <strong>{CONTACTS.NAME}</strong>
            </li>
            <li>
              <a href={`tel:${CONTACTS.PHONE.replace(/\s/g, '')}`}>
                {CONTACTS.PHONE}
              </a>
            </li>
            <li>
              <a href={`mailto:${CONTACTS.EMAIL}`}>{CONTACTS.EMAIL}</a>
            </li>
            <li>{CONTACTS.ADDRESS}</li>
          </ul>
          <p class="mt-8 text-center">
            <a
              href={VCARD_PATH}
              download
              class="inline-block bg-gold-500 hover:bg-gold-600 text-navy-900 px-6 py-2 rounded-md font-medium no-underline transition-colors"
            >
              Download vCard (.vcf)
            </a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @reference '../../styles/global.css';

  .prose h2 {
    @apply border-b border-gold-200 pb-2;
  }

  .prose h3 {
    @apply text-navy-800;
  }

  .prose ul {
    @apply text-gray-700;
  }

  .prose strong {
    @apply text-navy-900;
  }
</style>
