---
import { CONTACTS, OFFICE_MAPS_URL } from '@consts'
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { useTranslations, getLangFromUrl } from '../i18n/utils'
import ContactFields from '../components/ContactFields.astro'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout
  googleMaps
  title="Contacto - IVS Legal"
  description="Contacte a IVS Legal em Matosinhos para agendar uma consulta jurídica. Consulte a morada, telefone, email e horário do escritório."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-navy-900 to-navy-800 text-white py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-5xl font-serif font-bold mb-6">
            <span class="text-gold-400">Contacte-nos</span>
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed">
            Estamos aqui para ajudar. Agende uma consulta e descubra como
            podemos resolver a sua situação jurídica.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Information -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          <!-- Office Info -->
          <div class="text-center">
            <div class="w-20 h-20 bg-gold-500 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                ></path>
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-navy-900 mb-4">Escritório</h2>
            <a
              href={OFFICE_MAPS_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="block text-gray-600 mb-4 underline underline-offset-4"
            >
              <span class="block mb-2">{t('contact.address1')}</span>
              <span class="block">{t('contact.address2')}</span>
            </a>
            <p class="text-sm text-gray-500">{t('contact.hours.data')}</p>
          </div>

          <!-- Phone Info -->
          <div class="text-center">
            <div class="w-20 h-20 bg-gold-500 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-navy-900 mb-4">Telefone</h2>
            <p class="text-gray-600 mb-2">
              <a
                class="underline underline-offset-4"
                href={`tel:${CONTACTS.PHONE.replace(/\s/g, '')}`}
              >
                {CONTACTS.PHONE}
              </a>
            </p>
            <p class="text-sm text-gray-500">Linha direta disponível</p>
          </div>

          <!-- Email Info -->
          <div class="text-center">
            <div class="w-20 h-20 bg-gold-500 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-navy-900 mb-4">Email</h2>
            <p class="text-gray-600 mb-2">
              <a
                class="underline underline-offset-4"
                href={`mailto:${CONTACTS.EMAIL}`}
              >
                {CONTACTS.EMAIL}
              </a>
            </p>
            <p class="text-sm text-gray-500">
              Resposta garantida
              <br />
              em 24 horas
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Form -->
    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-4xl font-serif font-bold text-navy-900 mb-4">
              Solicite uma <span class="text-gold-800">Consulta</span>
            </h2>
            <p class="text-xl text-gray-600">
              Preencha o formulário abaixo e entraremos em contacto consigo
              brevemente.
            </p>
          </div>

          <div class="bg-white rounded-xl shadow-lg p-8">
            <ContactFields detailed />
          </div>
        </div>
      </div>
    </section>

    <!-- Map Section -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-serif font-bold text-navy-900 mb-4">
            Como <span class="text-gold-800">Chegar</span>
          </h2>
          <p class="text-xl text-gray-600">
            Estamos localizados em Leça da Palmeira, Matosinhos, com fácil
            acesso e estacionamento.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <!-- Map Placeholder -->

          <div class="bg-gray-200 rounded-xl h-96 flex items-center justify-center overflow-hidden">
            <gmp-map
              center="41.201019287109375,-8.706390380859375"
              zoom="12"
              map-id="DEMO_MAP_ID"
            >
              <gmp-advanced-marker
                position="41.201019287109375,-8.706390380859375"
                title="IVS Legal"
              ></gmp-advanced-marker>
            </gmp-map>
          </div>

          <!-- Directions -->
          <div class="space-y-6">
            <div class="bg-gold-50 p-6 rounded-lg">
              <h3 class="font-semibold text-navy-900 mb-2">Dica Importante</h3>
              <p class="text-sm text-gray-700">
                Recomendamos que confirme a sua consulta por telefone ou email.
                Para consultas urgentes, contacte-nos diretamente por telefone.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
