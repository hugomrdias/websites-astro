{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ivs-legal-staging",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "routes": [
    {
      "pattern": "dev.ivs.legal",
      "custom_domain": true,
    },
  ],
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "CONTACT_ENV": "staging",
    "CONTACT_ORIGIN": "https://dev.ivs.legal",
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["website@ivs.legal"],
      "allowed_destination_addresses": ["geral@ivs.legal"],
    },
  ],
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "2026092001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "env": {
    "production": {
      "name": "ivs-legal",
      "routes": [
        {
          "pattern": "ivs.legal",
          "custom_domain": true,
        },
      ],
      "vars": {
        "CONTACT_ENV": "production",
        "CONTACT_ORIGIN": "https://ivs.legal",
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["website@ivs.legal"],
          "allowed_destination_addresses": ["geral@ivs.legal"],
        },
      ],
      "ratelimits": [
        {
          "name": "CONTACT_LIMITER",
          "namespace_id": "2026092002",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
      "secrets": {
        "required": ["TURNSTILE_SECRET_KEY"],
      },
    },
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"],
  },
}
