{
  "name": "ivs.legal",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/prepare-build.mjs && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "wrangler types && astro check && biome check . && prettier --check '**/*.astro' --ignore-path ../../.gitignore --ignore-path .gitignore",
    "lint:fix": "biome check --write . && prettier --write '**/*.astro' --ignore-path ../../.gitignore --ignore-path .gitignore",
    "types": "wrangler types",
    "test": "node --test tests/*.test.ts",
    "favicons": "pwa-assets-generator",
    "wrangler:deploy": "wrangler deploy --config dist/server/wrangler.json",
    "wrangler:preview": "wrangler preview --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.0",
    "@astrojs/sitemap": "catalog:",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@yeskunall/astro-umami": "catalog:",
    "astro": "catalog:",
    "cuer": "catalog:",
    "hast-util-from-html": "catalog:",
    "hast-util-select": "catalog:",
    "hast-util-to-mdast": "catalog:",
    "hast-util-to-string": "catalog:",
    "mdast-util-gfm-strikethrough": "catalog:",
    "mdast-util-gfm-table": "catalog:",
    "mdast-util-to-markdown": "catalog:",
    "notro-loader": "0.4.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "^4.3.3",
    "vcard-creator": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/react": "catalog:",
    "@astrojs/ts-plugin": "catalog:",
    "@biomejs/biome": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vite-pwa/assets-generator": "catalog:",
    "astro-icon": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
