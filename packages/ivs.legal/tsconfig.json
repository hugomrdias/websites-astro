{
  "extends": "../../tsconfig.json",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "dev-dist"],
  "compilerOptions": {
    "paths": {
      "@*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
