{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decentralised-dev-staging",
  "compatibility_date": "2025-09-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  // Pull request Previews (`wrangler preview`) live under this Worker.
  "previews": {},
  "env": {
    "production": {
      "name": "decentralised-dev",
      "compatibility_date": "2025-09-04",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "routes": [
        {
          "pattern": "decentralised.dev",
          "custom_domain": true
        }
      ]
    }
  }
}
