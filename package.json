{
  "name": "websites-astro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^24.21.0",
    "pnpm": "^12.14.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "biome format --write . && prettier --write '**/*.{astro,yml}' --ignore-path .gitignore",
    "format:check": "biome format . && prettier --check '**/*.{astro,yml}' --ignore-path .gitignore",
    "clean": "rm -rf node_modules pnpm-lock.yaml .turbo packages/*/{pnpm-lock.yaml,.astro,.turbo,dist,node_modules}"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "astro": "catalog:",
    "depcheck": "^1.4.7",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "turbo": "^2.11.9",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
