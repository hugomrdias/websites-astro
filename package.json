{
  "name": "websites-astro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.wYum2HmT09Fky16JSPMrLAbuhUSH4GzY2GeBNC+z5btGNDZwNHEehoArqpw3vqkGzhkprQjXCITJfYAd8TOJpg==",
  "engines": {
    "node": "^24.21.0",
    "pnpm": "^12.14.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "format": "biome format --write . && prettier --write '**/*.{astro,yml}' --ignore-path .gitignore",
    "format:check": "biome format . && prettier --check '**/*.{astro,yml}' --ignore-path .gitignore",
    "clean": "rm -rf node_modules pnpm-lock.yaml packages/*/{pnpm-lock.yaml,.astro,dist,node_modules}",
    "lint": "pnpm -r --if-present run lint",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "astro": "catalog:",
    "depcheck": "^1.4.3",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
